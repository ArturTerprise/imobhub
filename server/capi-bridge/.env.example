# Modelo do /etc/openai-capi-bridge.env na VPS (chmod 600, root:root).
# NUNCA versionar o arquivo preenchido: os valores abaixo sao segredos.

PORT=3390

# OpenAI Ads
OPENAI_PIXEL_ID=XKQYHEcYkmBMgc2tizJwzK
OPENAI_CAPI_KEY=

# Calendly (plano free = sem webhook, por isso o poller le /scheduled_events)
CALENDLY_PAT=
CALENDLY_USER_URI=https://api.calendly.com/users/1811067c-3979-4d60-8f33-88e86649980f
CALENDLY_POLL_MINUTES=10

ALLOWED_ORIGIN=https://imobhub.app
CURRENCY=BRL

# true = validate_only na CAPI: valida o payload e NAO registra conversao.
# Serve para subir em ensaio antes de valer de verdade.
DRY_RUN=true
